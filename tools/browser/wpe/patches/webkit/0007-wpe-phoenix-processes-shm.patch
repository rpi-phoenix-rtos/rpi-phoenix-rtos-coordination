+#if OS(PHOENIX)
+// Phoenix-RTOS has no shared libraries: the UI, web and network processes are one static
+// multi-call program, and every child runs that same executable. Its main() records its own
+// absolute path in WPE_PHOENIX_EXECUTABLE (inherited by the children); ProcessLauncherGLib
+// tells the child its role in WPE_PHOENIX_PROCESS_ROLE.
+static String findWebKitProcess(const ASCIILiteral)
+{
+    const char* executable = g_getenv("WPE_PHOENIX_EXECUTABLE");
+    if (executable && *executable)
+        return FileSystem::stringFromFileSystemRepresentation(executable);
+    return FileSystem::stringFromFileSystemRepresentation(WPE_PHOENIX_DEFAULT_EXECUTABLE);
+}
