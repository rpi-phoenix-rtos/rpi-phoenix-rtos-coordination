 #endif
 
+#if OS(PHOENIX)
+#include <atomic>
+#include <stdio.h>
+// Phoenix-RTOS has no POSIX shared memory in libphoenix: memfd_create() comes from the
+// wayland_phoenix compat library (libwlphx-compat.a), backed by the shmsrv server (/shm/<id>,
+// pages memExport()ed, so every mmap() of the descriptor in any process maps the same pages).
+extern "C" int memfd_create(const char* name, unsigned flags);
+#ifndef MFD_CLOEXEC
+#define MFD_CLOEXEC 0x0001U
+#endif
+#endif
+
 namespace WebCore {
 
+#if OS(PHOENIX)
+// The shm-model decision of the browser plan (B6) needs WebKit's allocation profile: every
+// shmsrv object is contiguous and fixed-size. WPE_PHOENIX_SHM_LOG=1 prints one line per
+// allocation and per mapping of a received handle.
+static bool shmLogEnabled()
+{
+    static const bool enabled = [] {
+        const char* value = getenv("WPE_PHOENIX_SHM_LOG");
+        return value && *value && *value != '0';
+    }();
+    return enabled;
+}
+
+static void shmLog(const char* what, size_t size, int fd)
+{
+    static std::atomic<unsigned> count;
+    static std::atomic<size_t> total;
+    unsigned n = ++count;
+    size_t t = (total += size);
+    fprintf(stderr, "PHXSHM %s pid=%d fd=%d size=%zu n=%u total=%zu\n", what, static_cast<int>(getpid()), fd, size, n, t);
+}
+#endif
