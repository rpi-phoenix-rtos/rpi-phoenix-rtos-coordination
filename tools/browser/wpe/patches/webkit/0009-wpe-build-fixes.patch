Subject: WPE: build fixes for ENABLE_VIDEO=OFF, USE_LIBDRM=OFF and a libc without MSG_CTRUNC

JSHTMLMediaElementCustom.cpp is compiled with ENABLE_VIDEO=OFF and needs #if ENABLE(VIDEO)
(upstream bug). AcceleratedBackingStore.cpp compares against DRM_FORMAT_XRGB8888 without
<drm_fourcc.h> when USE_LIBDRM=OFF (upstream bug): define the fourcc. libphoenix has no
MSG_CTRUNC (its kernel never truncates control data): skip that check where it is undefined.

diff --git a/Source/WebCore/bindings/js/JSHTMLMediaElementCustom.cpp b/Source/WebCore/bindings/js/JSHTMLMediaElementCustom.cpp
index 61c33bf7614fbee6b270c1c20d1403109ba15ed6..4c6615a7423adca3ea927a58169b5efaee3bfcbc 100644
--- a/Source/WebCore/bindings/js/JSHTMLMediaElementCustom.cpp
+++ b/Source/WebCore/bindings/js/JSHTMLMediaElementCustom.cpp
@@ -24,6 +24,9 @@
  */
 
 #include "config.h"
+
+#if ENABLE(VIDEO)
+
 #include "JSHTMLMediaElement.h"
 
 #include "TrackOpaqueRoot.h"
@@ -40,3 +43,5 @@ void JSHTMLMediaElement::visitAdditionalChildrenInGCThread(Visitor& visitor)
 DEFINE_VISIT_ADDITIONAL_CHILDREN_IN_GC_THREAD(JSHTMLMediaElement);
 
 } // namespace WebCore
+
+#endif // ENABLE(VIDEO)
diff --git a/Source/WebKit/Platform/IPC/glib/ConnectionGLib.cpp b/Source/WebKit/Platform/IPC/glib/ConnectionGLib.cpp
index d5b3cce63a792db10111b54a4e4b351d5611e6f6..c7c149cf3e9f348cb2ee05169f202ea2bc25aea4 100644
--- a/Source/WebKit/Platform/IPC/glib/ConnectionGLib.cpp
+++ b/Source/WebKit/Platform/IPC/glib/ConnectionGLib.cpp
@@ -255,10 +255,12 @@ static ssize_t readBytesFromSocket(GSocket* socket, Vector<uint8_t>& buffer, Vec
     if (bytesRead <= 0)
         return bytesRead;
 
+#if defined(MSG_CTRUNC) // not in Phoenix-RTOS's libphoenix, whose kernel never truncates control data
     if (flags & MSG_CTRUNC) {
         // Control data has been discarded, so consider this a read failure.
         return -1;
     }
+#endif
 
     buffer.shrink(bytesRead);
     for (int i = 0; i < messagesCount; ++i) {
diff --git a/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp b/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp
index 22c44ab7d823a4ae8458ff5265fc935361e25e1f..aa6ced85f8d0078ff2b0f2cb0d3040d2738606e0 100644
--- a/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp
+++ b/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp
@@ -43,6 +43,11 @@
 #include <drm_fourcc.h>
 #endif
 
+#ifndef DRM_FORMAT_XRGB8888
+// USE_LIBDRM=OFF: the one fourcc this file compares against (drm_fourcc.h: fourcc_code('X', 'R', '2', '4'))
+#define DRM_FORMAT_XRGB8888 0x34325258
+#endif
+
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
 #include <skia/core/SkColorSpace.h>
 #include <skia/core/SkPixmap.h>
