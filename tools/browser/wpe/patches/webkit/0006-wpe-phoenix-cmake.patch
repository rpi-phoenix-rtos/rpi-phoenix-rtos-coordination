+# Phoenix-RTOS: PAL's digests (and WebCrypto, when enabled) come from OpenSSL, which the
+# system already ships for glib-networking, instead of libgcrypt + libtasn1.
+if (CMAKE_SYSTEM_NAME MATCHES "Phoenix")
+    find_package(OpenSSL 3.0 REQUIRED)
+else ()
+    find_package(LibGcrypt 1.7.0 REQUIRED)
+    find_package(Tasn1 REQUIRED)
+endif ()
