 #include "glamor_priv.h"
 #include "glamor_transfer.h"
+#include <stdlib.h>   /* realloc, for the screen-upload flip scratch */
+
+/* Phoenix RPi4: grow-only scratch for the screen-pixmap upload flip.
+ *
+ * The flip used to be done by uploading ONE ROW PER glTexSubImage2D call. That is
+ * correct but pathologically slow in the configuration the desktop actually runs:
+ * Xphoenix-glamor-daemon reaches the GPU through /dev/v3d-srv, so every GL call is
+ * an RPC to another process. A 640x480 XPutImage from the GL demo client therefore
+ * cost 480 round trips per frame, and that window updated about once a second.
+ *
+ * Flipping into a packed scratch buffer and issuing ONE bulk upload is exactly
+ * equivalent -- same destination rows, same bytes -- for one RPC instead of N. The
+ * copy is cached-to-cached memory, far cheaper than the calls it replaces. */
+static void *
+phx_flip_scratch(size_t need)
+{
+    static void *buf;
+    static size_t cap;
+
+    if (need > cap) {
+        void *nb = realloc(buf, need);
+
+        if (!nb)
+            return NULL;    /* caller falls back to the per-row loop */
+        buf = nb;
+        cap = need;
+    }
+    return buf;
+}
+
