Phoenix RPi4: extend the screen-pixmap Y-flip to glamor_spans.c.

xorg-server-21.1.24-glamor-screen-upload-yflip.patch established the fork's
invariant for the X screen/root pixmap: its GL texture holds row `y` of the
screen at texel row `H-1-y`. Rendering already lands that way (the v3d
rasterizer flips this FBO, because Mesa's size gate at
st_atom_framebuffer.c:137 leaves the full-screen framebuffer with the opposite
FlipY state from every smaller pixmap), and the scanout readback shim un-flips
it (PHX_READBACK_FLIP_Y=1). That patch therefore mirrors the CPU upload and
download paths in glamor_transfer.c to match.

It missed two more pixel-transfer call sites, in a different file.
glamor_get_spans_gl() and glamor_set_spans_gl() do their own glReadPixels /
glTexSubImage2D and index the FBO row straight from the X row, with no flip --
so on the screen pixmap they read and write the vertical mirror of the row
they were asked for.

Measured symptom (docs/misc/2026-09-08-glamor-screen-mirror-and-gl-window-rate.md):
two Y-mirrored copies of unrelated screen content on the Window Maker desktop,
each a pixel-exact vflip of another screen region about the FULL screen height
(mean|diff| 4.6 and 5.0 grey levels against 21 and 17 for the runner-up
offset) -- the `top` window's text appearing upside down inside the
Game-of-Life xterm, and a mirrored Clip icon in the bottom-left corner.

The mirror is applied under the same gate as the existing patch (screen pixmap
only; offscreen pixmaps keep upstream behaviour) and with the same arithmetic,
so the two files now agree. The diagnostic counters are deliberately one-shot
per direction: if these paths turn out never to run on the screen pixmap, the
absence of the message is the evidence, and this patch is then a no-op that
should be reverted rather than kept.

--- a/glamor/glamor_spans.c
+++ b/glamor/glamor_spans.c
@@ -176,6 +176,20 @@
     glamor_fill_spans_bail(drawable, gc, n, points, widths, sorted);
 }
 
+/* Phoenix RPi4 screen-pixmap Y-flip, part 2 (see
+ * tools/x11-port/patches/xorg-server-21.1.24-glamor-spans-yflip.patch).
+ *
+ * The X screen/root pixmap's GL texture holds screen row y at texel row
+ * H-1-y on this stack: the v3d rasterizer flips that FBO (Mesa's size gate in
+ * st_atom_framebuffer.c leaves the full-screen framebuffer with the opposite
+ * FlipY state from every smaller pixmap) and the scanout shim un-flips it on
+ * readback (PHX_READBACK_FLIP_Y=1). glamor_transfer.c was already mirrored to
+ * match; these two span paths do their own glReadPixels/glTexSubImage2D and
+ * were missed, so on the screen pixmap they touched the vertical MIRROR of the
+ * row asked for. Offscreen pixmaps are NOT flipped -- gate on the screen
+ * pixmap only, exactly as glamor_transfer.c does. */
+#define PHX_SPAN_FLIP_ROW(flip, h, y) ((flip) ? ((h) - 1 - (y)) : (y))
+
 static Bool
 glamor_get_spans_gl(DrawablePtr drawable, int wmax,
                     DDXPointPtr points, int *widths, int count, char *dst)
@@ -189,6 +203,8 @@
     char *d;
     int off_x, off_y;
     const struct glamor_format *f = glamor_format_for_pixmap(pixmap);
+    Bool phx_flip = (pixmap == (*screen->GetScreenPixmap)(screen));
+    int phx_h = pixmap->drawable.height;
 
     pixmap_priv = glamor_get_pixmap_private(pixmap);
     if (!GLAMOR_PIXMAP_PRIV_HAS_FBO(pixmap_priv))
@@ -196,6 +212,15 @@
 
     glamor_get_drawable_deltas(drawable, pixmap, &off_x, &off_y);
 
+    if (phx_flip) {
+        static int once = 0;
+        if (once == 0) {
+            once = 1;
+            ErrorF("glamor-phx: GetSpans on the SCREEN pixmap (h=%d) "
+                   "- Y-flip applied\n", phx_h);
+        }
+    }
+
     glamor_make_current(glamor_priv);
 
     glamor_pixmap_loop(pixmap_priv, box_index) {
@@ -231,7 +256,9 @@
             if (y >= box->y2)
                 continue;
 
-            glReadPixels(x1 - box->x1, y - box->y1, x2 - x1, 1,
+            glReadPixels(x1 - box->x1,
+                         PHX_SPAN_FLIP_ROW(phx_flip, phx_h, y) - box->y1,
+                         x2 - x1, 1,
                          f->format, f->type, l);
         }
     }
@@ -272,6 +299,8 @@
     int n;
     char *s;
     int off_x, off_y;
+    Bool phx_flip = (pixmap == (*screen->GetScreenPixmap)(screen));
+    int phx_h = pixmap->drawable.height;
 
     pixmap_priv = glamor_get_pixmap_private(pixmap);
     if (!GLAMOR_PIXMAP_PRIV_HAS_FBO(pixmap_priv))
@@ -285,6 +314,15 @@
 
     glamor_get_drawable_deltas(drawable, pixmap, &off_x, &off_y);
 
+    if (phx_flip) {
+        static int once = 0;
+        if (once == 0) {
+            once = 1;
+            ErrorF("glamor-phx: SetSpans on the SCREEN pixmap (h=%d) "
+                   "- Y-flip applied\n", phx_h);
+        }
+    }
+
     glamor_make_current(glamor_priv);
 
     glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
@@ -343,7 +381,9 @@
                     continue;
 
                 glTexSubImage2D(GL_TEXTURE_2D, 0,
-                                x1 - box->x1, y1 - box->y1, x2 - x1, 1,
+                                x1 - box->x1,
+                                PHX_SPAN_FLIP_ROW(phx_flip, phx_h, y1) - box->y1,
+                                x2 - x1, 1,
                                 f->format, f->type,
                                 l);
             }
