                     glTexSubImage2D(GL_TEXTURE_2D, 0,
                                     x1 - box->x1, y1 - box->y1,
                                     x2 - x1, 1,
-                                    f->format, f->type,
+                                    format, type,
                                     bits + ofs);
             }
