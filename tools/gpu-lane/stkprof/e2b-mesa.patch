+#ifdef V3D_PHX_RES_CENSUS
+/* Phoenix experiment E2b (docs/gpu-new-lane/E2b-v3d-render-slowness.md in the
+ * phoenix-rpi coordination repo), compiled only into a cloned profiling binary: which
+ * memory layout did every resource get? Counts CREATED resources by class and by the
+ * level-0 tiling mode, and prints each render target / depth buffer / large texture as
+ * it is created. v3d_phx_res_census_report() is called by the winsys once per profile
+ * window and prints the table when it changed. */
+enum { PHX_RC_BUF, PHX_RC_TEX, PHX_RC_RT, PHX_RC_DS, PHX_RC_N };
+static uint32_t phx_rc_n[PHX_RC_N][6];
+static uint64_t phx_rc_kb[PHX_RC_N][6];
+static bool phx_rc_dirty;
+
+void v3d_phx_res_census_report(void);
+void
+v3d_phx_res_census_report(void)
+{
+        static const char cls[PHX_RC_N] = { 'b', 't', 'r', 'd' };
+        char buf[512];
+        size_t o = 0;
+
+        if (!phx_rc_dirty)
+                return;
+        phx_rc_dirty = false;
+        for (int c = 0; c < PHX_RC_N; c++) {
+                o += snprintf(buf + o, sizeof(buf) - o, " %c=", cls[c]);
+                for (int t = 0; t < 6 && o < sizeof(buf) - 32; t++)
+                        o += snprintf(buf + o, sizeof(buf) - o, t ? ",%u/%llu" : "%u/%llu",
+                                      phx_rc_n[c][t], (unsigned long long)phx_rc_kb[c][t]);
+        }
+        /* per class: count/KiB for tiling RASTER,LINEARTILE,UBLINEAR1,UBLINEAR2,UIF,UIF_XOR */
+        fprintf(stderr, "v3d-res-census:%s\n", buf);
+}
+
+static void
+v3d_phx_res_census(struct v3d_resource *rsc)
+{
+        const struct pipe_resource *p = &rsc->base;
+        int c, t = rsc->slices[0].tiling;
+
+        if (p->target == PIPE_BUFFER)
+                c = PHX_RC_BUF;
+        else if (p->bind & PIPE_BIND_DEPTH_STENCIL)
+                c = PHX_RC_DS;
+        else if (p->bind & PIPE_BIND_RENDER_TARGET)
+                c = PHX_RC_RT;
+        else
+                c = PHX_RC_TEX;
+        if (t < 0 || t > 5)
+                t = 5;
+        phx_rc_n[c][t]++;
+        phx_rc_kb[c][t] += rsc->size / 1024;
+        phx_rc_dirty = true;
+        if (c == PHX_RC_RT || c == PHX_RC_DS ||
+            (c == PHX_RC_TEX && (p->width0 >= 1024 || p->height0 >= 1024))) {
+                fprintf(stderr, "v3d-res-census: new %c %ux%u fmt=%u bind=0x%x lvls=%u "
+                        "samples=%u tiling=%d tiled=%d size=%u scanout_bo=%d\n",
+                        "btrd"[c], p->width0, p->height0, p->format, p->bind,
+                        p->last_level + 1, p->nr_samples, t, rsc->tiled, rsc->size,
+                        rsc->bo ? rsc->bo->scanout : -1);
+        }
+}
+#endif
+
 static struct pipe_resource *
