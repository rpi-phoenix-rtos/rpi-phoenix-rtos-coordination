+#ifdef V3D_PHX_JOB_NOTE
+/* Phoenix experiment E2b (docs/gpu-new-lane/E2b-v3d-render-slowness.md in the
+ * phoenix-rpi coordination repo), compiled only into a cloned profiling binary.
+ * Hands the in-process winsys a description of the job it is about to execute, so the
+ * GPU performance counters it reads per job can be attributed to a pass (size, tiles,
+ * render targets, draws, load/store masks, early-Z state). The winsys defines the
+ * receiver only in its -DV3D_PHX_SUBMIT_PROFILE build, hence the weak reference.
+ *
+ * Layout (word 0 = layout version 1): 1 draw_width, 2 draw_height, 3 tiles_x,
+ * 4 tiles_y, 5 tile_w, 6 tile_h, 7 nr_cbufs, 8 internal_bpp, 9 draw_calls_queued,
+ * 10 msaa, 11 double_buffer, 12 clear_tlb, 13 load, 14 store, 15 invalidated_load,
+ * 16 first_ez_state, 17 ez_state, 18 zs present | zs tiling<<8 | zs cpp<<16,
+ * 19 cbuf0 tiling | cbuf0 scanout-BO<<8 | cbuf0 cpp<<16, 20 tmu_dirty_rcl,
+ * 21 num_layers, 22 scissor count | scissor disabled<<16, 23 clear_draw | blit_tlb<<16.
+ * PIPE_CLEAR_* bits: 1 depth, 2 stencil, 4 << i colour buffer i. */
+extern void v3d_phx_job_note(const uint32_t *v, unsigned n) __attribute__((weak));
+
+static void
+v3d_phx_note_job(struct v3d_job *job)
+{
+        static bool banner;
+        uint32_t v[24] = { 1 };
+
+        if (v3d_phx_job_note == NULL)
+                return;
+        if (!banner) {
+                banner = true;
+                fprintf(stderr, "v3d-job-note: E2b per-job notes on (layout 1)\n");
+        }
+        v[1] = job->draw_width;
+        v[2] = job->draw_height;
+        v[3] = job->tile_desc.draw_x;
+        v[4] = job->tile_desc.draw_y;
+        v[5] = job->tile_desc.width;
+        v[6] = job->tile_desc.height;
+        v[7] = job->nr_cbufs;
+        v[8] = job->internal_bpp;
+        v[9] = job->draw_calls_queued;
+        v[10] = job->msaa;
+        v[11] = job->double_buffer;
+        v[12] = job->clear_tlb;
+        v[13] = job->load;
+        v[14] = job->store;
+        v[15] = job->invalidated_load;
+        v[16] = job->first_ez_state;
+        v[17] = job->ez_state;
+        if (job->zsbuf.texture) {
+                struct v3d_resource *rsc = v3d_resource(job->zsbuf.texture);
+                v[18] = 1 | (rsc->slices[job->zsbuf.level].tiling << 8) |
+                        (rsc->cpp << 16);
+        }
+        if (job->nr_cbufs > 0 && job->cbufs[0].texture) {
+                struct v3d_resource *rsc = v3d_resource(job->cbufs[0].texture);
+                v[19] = rsc->slices[job->cbufs[0].level].tiling |
+                        ((rsc->bo && rsc->bo->scanout) ? 1u << 8 : 0) |
+                        (rsc->cpp << 16);
+        }
+        v[20] = job->tmu_dirty_rcl;
+        v[21] = job->num_layers;
+        v[22] = job->scissor.count | (job->scissor.disabled ? 1u << 16 : 0);
+        v[23] = job->clear_draw | (job->blit_tlb << 16);
+        v3d_phx_job_note(v, 24);
+}
+#endif
+
