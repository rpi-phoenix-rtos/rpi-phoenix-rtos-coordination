+#ifdef V3D_PHX_EZ_KNOB
+/* Phoenix experiment E2b (docs/gpu-new-lane/E2b-v3d-render-slowness.md in the
+ * phoenix-rpi coordination repo), compiled only into a cloned profiling binary:
+ * `export V3D_PHX_EZ=1` lets upstream's early-Z state machine run instead of the
+ * port's unconditional force-off below. Unset (the default, even in the profiling
+ * build) keeps the shipped behaviour. */
+static int
+v3d_phx_ez_allowed(void)
+{
+        static int allowed = -1;
+
+        if (allowed < 0) {
+                const char *e = getenv("V3D_PHX_EZ");
+
+                allowed = (e != NULL && e[0] == '1');
+                fprintf(stderr, "V3D_PHX_EZ knob: early-Z %s\n",
+                        allowed ? "UPSTREAM (knob on)" : "forced off (shipped)");
+        }
+        return allowed;
+}
+#endif
