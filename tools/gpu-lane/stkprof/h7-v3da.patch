+ * and before CT1, no fix-A, no post-render clean. */
+#define V3DA_KNOB_LINUX           (V3DA_KNOB_TLB_ON_CHANGE | V3DA_KNOB_NO_L2T_WAIT_NEW | V3DA_KNOB_NO_FIXA | \
